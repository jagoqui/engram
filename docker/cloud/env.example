# Engram Cloud — environment template for docker-compose.cloud.yml.
#
# This stack has its own env file, separate from the engram-http stack's
# root `.env`, so the two never collide when both run from this directory:
#
#   cp docker/cloud/env.example .env.cloud
#   docker compose --env-file .env.cloud -f docker-compose.cloud.yml up -d
#
# .env.cloud is gitignored — never commit real secrets. Every var below is
# documented in docs/engram-cloud/quickstart.md and docs/engram-cloud/README.md.
#
# With NO env file at all, `docker compose -f docker-compose.cloud.yml up`
# still works exactly as before: insecure dev smoke mode, published on
# 127.0.0.1:18080, allowlisting only `smoke-project`.

# --- Published bind / port (host-side) -----------------------------------
# What's reachable outside the container. Dev default is loopback-only.
ENGRAM_CLOUD_BIND_ADDR=127.0.0.1
ENGRAM_CLOUD_PUBLISHED_PORT=18080

# Postgres's published port on the host (Postgres itself is only ever
# published on 127.0.0.1 — it's not meant to be reachable off-host; only
# the port is configurable, to avoid local port clashes).
ENGRAM_CLOUD_POSTGRES_PORT=5433

# --- Postgres credentials --------------------------------------------------
# Used both by the postgres container and to build ENGRAM_DATABASE_URL below
# (unless ENGRAM_DATABASE_URL is set directly, which then wins).
POSTGRES_USER=engram
POSTGRES_PASSWORD=engram_dev
POSTGRES_DB=engram_cloud

# Production: generate a real password, e.g.
#   POSTGRES_PASSWORD=$(openssl rand -hex 32)

# Set this instead of the POSTGRES_* vars above if you point at Postgres
# that isn't the postgres service in this compose file (e.g. a managed
# Postgres instance):
# ENGRAM_DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable

# --- Auth --------------------------------------------------------------
# Dev default: insecure, no auth, single allowlisted smoke project.
ENGRAM_CLOUD_INSECURE_NO_AUTH=1
ENGRAM_CLOUD_ALLOWED_PROJECTS=smoke-project

# Production: set ENGRAM_CLOUD_INSECURE_NO_AUTH=0, list your real projects,
# and configure the vars below.
#
# ENGRAM_CLOUD_INSECURE_NO_AUTH=0
# ENGRAM_CLOUD_ALLOWED_PROJECTS=my-project,another-project

# Required, non-default, in authenticated mode (ENGRAM_CLOUD_INSECURE_NO_AUTH=0):
#   ENGRAM_JWT_SECRET=$(openssl rand -hex 32)
# ENGRAM_JWT_SECRET=replace-with-a-generated-secret

# Legacy bearer token. NOTE: authenticated `cloud serve` currently REQUIRES
# this to be set even when clients authenticate with managed tokens instead
# (see ENGRAM_CLOUD_TOKEN_PEPPER below). Generate with:
#   ENGRAM_CLOUD_TOKEN=$(openssl rand -hex 32)
# ENGRAM_CLOUD_TOKEN=replace-with-a-generated-token

# Legacy dashboard admin token. Must stay unset while
# ENGRAM_CLOUD_INSECURE_NO_AUTH=1 (the server refuses to start otherwise).
# Only set it in authenticated mode, distinct from ENGRAM_CLOUD_TOKEN:
#   ENGRAM_CLOUD_ADMIN=$(openssl rand -hex 32)
# ENGRAM_CLOUD_ADMIN=replace-with-a-generated-token

# Dedicated secret to enable managed (bootstrap-issued) user tokens,
# distinct from ENGRAM_JWT_SECRET and ENGRAM_CLOUD_TOKEN. Required both to
# run `engram cloud bootstrap admin --issue-token` against this stack and
# for the resulting managed tokens to authenticate against it. Generate
# with:
#   ENGRAM_CLOUD_TOKEN_PEPPER=$(openssl rand -hex 32)
# ENGRAM_CLOUD_TOKEN_PEPPER=replace-with-a-generated-secret

# --- Bootstrap the first managed admin (production) -----------------------
# After the stack is up with the auth vars above set, create the first
# managed admin and issue its token from inside the running container:
#
#   docker exec -it engram-cloud engram cloud bootstrap admin \
#     --username <u> --email <e> --grant-project <p> --issue-token <name>
