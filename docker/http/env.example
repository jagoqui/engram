# Engram HTTP — environment template.
#
# Copy this file to .env at the repository root before running
# `docker compose -f docker-compose.http.yml up`:
#
#   cp docker/http/env.example .env
#
# .env is gitignored — never commit real tokens. Every var below is
# documented in docs/engram-http/README.md.

# --- Bind / listen -----------------------------------------------------
# The container's internal listen address is fixed at 0.0.0.0:7438 by
# docker/http/Dockerfile's CMD (a --listen flag always wins over the
# ENGRAM_MCP_HTTP_ADDR env var engram also supports, so setting that var
# here would have no effect — it's intentionally not listed). To change
# what's reachable from outside the container, set these instead (read by
# docker-compose.http.yml, not by engram itself):
#
# ENGRAM_HTTP_BIND_ADDR=127.0.0.1
# ENGRAM_HTTP_PUBLISHED_PORT=7438
#
# Dev default is loopback-only. On a real server, set
# ENGRAM_HTTP_BIND_ADDR=0.0.0.0 (or a specific interface) to publish beyond
# localhost — see docs/engram-http/README.md#security for the auth/TLS
# steps to take first.

# --- Local-only auth (mutually exclusive with the cloud block below) ---
# Guards every /mcp request with a static bearer token compared
# constant-time. Leave unset only when the port stays on loopback and you
# trust every local process; set it before exposing the port beyond
# 127.0.0.1.
# ENGRAM_MCP_HTTP_TOKEN=change-me-to-a-long-random-token

# Comma-separated exact-match Origin allowlist. Any request carrying an
# Origin header is rejected unless it's listed here (DNS-rebinding guard for
# browser-originated clients).
# ENGRAM_MCP_HTTP_ALLOWED_ORIGINS=https://your-client.example.com

# Comma-separated Host allowlist beyond loopback. Only checked when
# ENGRAM_MCP_HTTP_TOKEN is unset and cloud mode isn't authenticating the
# request with its own bearer.
# ENGRAM_MCP_HTTP_ALLOWED_HOSTS=engram.your-domain.example.com

# --- Data directory ------------------------------------------------------
# Already set to /data by the image; only change this if you remap the
# volume mount target in docker-compose.http.yml to something else.
# ENGRAM_DATA_DIR=/data

# --- Optional Engram Cloud sync -----------------------------------------
# Uncomment this whole block to sync this container's memories to a running
# Engram Cloud instance (separate image — see docker-compose.cloud.yml and
# docs/engram-cloud/README.md). When this block is set, do NOT also set
# ENGRAM_MCP_HTTP_TOKEN above: engram fails to start if both are configured,
# since the Authorization header can only mean one or the other.
#
# The cloud server must support GET /auth/whoami (used to bind the request
# bearer to the cloud principal); an older cloud server without that route
# makes every MCP request fail closed with 503.
#
# ENGRAM_CLOUD_TOKEN is OPTIONAL: leave it unset for bearer-only cloud mode —
# the first request's Authorization: Bearer that Engram Cloud accepts pins
# the instance owner for the container's lifetime and starts sync with that
# bearer. Set it only to pin the owner explicitly and start sync at boot.
#
# ENGRAM_CLOUD_AUTOSYNC=1
#
# ENGRAM_CLOUD_SERVER: pick ONE of:
#   - Remote server:  https://cloud.example.com
#   - Same host, cloud in a sibling container (docker-compose.cloud.yml):
#       http://host.docker.internal:18080
#     This requires the cloud stack's ENGRAM_CLOUD_BIND_ADDR to publish on
#     an address reachable from this container, not loopback-only — e.g.
#     ENGRAM_CLOUD_BIND_ADDR=172.17.0.1 (the default Docker bridge gateway,
#     reachable from any container on the default network) or 0.0.0.0
#     (reachable from anywhere; put it behind a firewall/reverse proxy).
#     127.0.0.1 (the cloud stack's own dev default) is NOT reachable from
#     another container.
# ENGRAM_CLOUD_SERVER=http://host.docker.internal:18080
#
# ENGRAM_CLOUD_TOKEN=change-me-to-your-cloud-token

# --- Tool profile ---------------------------------------------------------
# The image's CMD always runs `engram mcp --transport=http`, with no
# --tools=PROFILE flag (so all tools are registered — see `engram mcp
# --help`). engram has no ENGRAM_MCP_TOOLS env-var equivalent for --tools,
# so this can't be set from this file. To run a restricted tool profile
# (e.g. --tools=agent), override the command in a local compose file
# instead, e.g. docker-compose.http.local.yml:
#
#   services:
#     engram-http:
#       command: ["mcp", "--transport=http", "--listen=0.0.0.0:7438", "--tools=agent"]
#
# then: docker compose -f docker-compose.http.yml -f docker-compose.http.local.yml up -d
